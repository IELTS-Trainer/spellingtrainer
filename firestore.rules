rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{userId} {
      // A signed-in user can check only their own admin record.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.accessLevel == 'ordinary'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 30
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'accessLevel', 'createdAt', 'updatedAt',
          'firstName', 'lastName', 'nationality', 'city', 'learningPurpose', 'phoneNumber'
        ]);

      allow update: if isAdmin()
        && request.resource.data.accessLevel in ['ordinary', 'premium']
        || signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.accessLevel == resource.data.accessLevel
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'firstName', 'lastName', 'nationality', 'city',
          'learningPurpose', 'updatedAt'
        ]);

      allow delete: if isAdmin();
    }

    match /loginEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'eventType', 'timestamp', 'userAgent'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.eventType in ['sign_in', 'sign_up']
        && request.resource.data.timestamp == request.time
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 500;

      allow get, list: if isAdmin();
      allow update, delete: if false;
    }
  }
}